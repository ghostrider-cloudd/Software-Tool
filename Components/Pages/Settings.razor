@page "/settings"

<PageTitle>Settings - DTRI</PageTitle>

<div class="page-content">

    <div class="page-title">
        Settings
    </div>

    <div class="settings-toolbar">

        <select class="device-select">
            <option value="">Select Device</option>
        </select>

        <button type="button" class="tool-button">
            Remote Scan
        </button>

    </div>

    <div class="settings-actions">

        <button type="button" class="tool-button">
            Read
        </button>

        <button type="button" class="tool-button">
            Write All
        </button>

        <button type="button" class="tool-button">
            Import
        </button>

        <button type="button" class="tool-button">
            Export
        </button>

        <button type="button" class="tool-button">
            Reset
        </button>

    </div>

    <div class="settings-message">
        Connect to your RFD modem to get started
    </div>

</div>